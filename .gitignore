# Local secrets / env
.env

# Node (frida tooling)
node_modules/

# Re-signed debuggable client copy (~465 MB) made by sniffer/tools/resign-debug-app.sh
build/
sniffer/build/

# Next.js web app (added later)
web/node_modules/
web/.next/
web/out/

# Generated by Cargo (the Rust app lives in sniffer/)
debug
target/
sniffer/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS
.DS_Store

# Il2CppDumper output — 64 MB, regenerate with Il2CppDumper (see RUNBOOK part 3)
sniffer/reference/il2cpp-dump-20260710/dump.cs
sniffer/reference/il2cpp-dump-20260710/il2cpp.h
sniffer/reference/il2cpp-dump-20260710/script.json

# Python bytecode (the ui-ux-pro-max skill writes it beside its scripts)
__pycache__/

# Database dumps written by the db-backup compose service (tools/backup_db.sh).
# Real captured data, but reproducible from the volume — and large.
backups/
