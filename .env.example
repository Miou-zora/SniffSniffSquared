# Copy to .env and fill in.  docker compose reads .env automatically.

# --- PostgreSQL (compose: db) ---
POSTGRES_USER=dofus
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dofus
POSTGRES_PORT=5432

# --- pgAdmin (compose: pgadmin) --- login at http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASS=change_me
PGADMIN_PORT=5050

# --- Web app ---
WEB_PORT=3000        # compose service `web` (production build)
WEB_DEV_PORT=3001    # compose service `web-dev` (hot reload, --profile dev)

# --- Sniffer app ---
# Capture interface. List them with:  cd sniffer && ./target/debug/SniffSniffSquared --list
# Native (macOS): en0. In the compose `sniffer` container (Linux only): eth0.
# Windows (needs Npcap): the real name is \Device\NPF_{GUID}, but a bound IP or
# a fragment of the adapter description works too -- e.g. DOFUS_DEV=192.168.1.10
# Use the address of the interface you are actually online through: an idle NIC
# sits on 169.254.x.x and captures nothing while looking perfectly healthy.
DOFUS_DEV=en0

# --- Database backups (compose service `db-backup`, starts by default) ---
# Seconds between dumps, and how many to keep. Dumps land in ./backups on the
# host, which survives `docker compose down -v` and a volume deleted in Docker
# Desktop -- the failure this is for. 24 hourly dumps of a 19 MB database is
# well under a GB; raise BACKUP_KEEP for more history.
BACKUP_INTERVAL=3600
BACKUP_KEEP=24

# Set to 0 to stop archiving every message to the `packets` table
ARCHIVE_PACKETS=1
# BPF capture filter. KEEP THE QUOTES: dotenvy stops parsing an unquoted value
# at the first space, which silently drops every variable declared after it —
# including DATABASE_URL, leaving the sniffer with no database and no error.
BPF_FILTER="tcp port 5555"
# where the sniffer writes captured packets
DATABASE_URL=postgres://dofus:change_me@localhost:5432/dofus
